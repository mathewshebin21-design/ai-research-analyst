# Copy to .env for local development. Never commit real keys.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./intel.db
STORAGE_DIR=./storage
CORS_ORIGINS=["http://localhost:3000"]

# dev: local sign-in without Supabase (refused when ENVIRONMENT=production)
# supabase: verify Supabase JWTs; set SUPABASE_URL and, for HS256 projects, SUPABASE_JWT_SECRET
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Required to run research
TAVILY_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Limits
RATE_LIMIT_PER_MINUTE=60
RUNS_PER_WORKSPACE_PER_MONTH=50
MAX_SEARCHES_PER_RUN=20
MAX_UPLOAD_MB=25
WORKER_IN_PROCESS=true
